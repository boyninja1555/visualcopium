{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "nodenext",
		"target": "esnext",
		"types": [
			"bun",
			"node"
		],
		"lib": [
			"ESNext",
			"DOM"
		],
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"composite": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,
	},
	"exclude": [
		"node_modules"
	],
	"include": [
		"src"
	]
}